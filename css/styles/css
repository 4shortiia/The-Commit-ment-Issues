    border-radius: 50%;
    background-color: transparent;
    position: absolute;
    top: 30rem;
    left: -3rem;
    z-index: 1;
    transform: rotate(-15deg);
    cursor: pointer;
    animation-name: Spin;
    animation-duration: 5s;
    animation-timing-function: linear;
    animation-iteration-count: infinite;
  }
